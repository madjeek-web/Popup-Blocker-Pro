{
  "manifest_version": 2,
  "name": "Popup Blocker Pro",
  "version": "1.0.0",
  "description": "Blocks unwanted popups and background tabs silently and efficiently. Open source, no data collection.",
  "author": "Popup Blocker Pro Contributors",

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Popup Blocker Pro"
  },

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "<all_urls>"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "popup-blocker-pro@extension",
      "strict_min_version": "78.0"
    }
  }
}
